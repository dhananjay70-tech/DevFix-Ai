# Active provider: one of "gemini", "xai", "openai"
LLM_PROVIDER=gemini

# Gemini (free tier via Google AI Studio) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# xAI (optional fallback provider)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.6

# OpenAI (optional provider)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o

NODE_CORE_API_URL=http://localhost:5000/api
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devfix_db

# Shared secret for AI backend -> Node backend service calls (must match Backend/.env)
INTERNAL_API_KEY=your_shared_internal_secret_here
