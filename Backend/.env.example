PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devfix_db?schema=public"
JWT_SECRET="devfix_jwt_secret_key_change_in_production"

# Gmail SMTP (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
GMAIL_SENDER_NAME=DevFix AI

# GitHub OAuth (github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback

FRONTEND_URL=http://localhost:5173

# AI backend (FastAPI + LangGraph)
AI_BACKEND_URL=http://localhost:8000

# Shared secret for AI backend -> Node backend service calls (must match ai-backend/.env)
INTERNAL_API_KEY=your_shared_internal_secret_here
